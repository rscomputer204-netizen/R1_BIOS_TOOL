# --- STORAGE STRATEGY ---
# "CLOUD" = Upload to S3/R2 & Delete Local (Live Mode)
# "LOCAL" = Move to local archive folder (Dev/Test Mode)
STORAGE_MODE="LOCAL"

# --- CLOUD CREDENTIALS (Required only if STORAGE_MODE="CLOUD") ---
# Cloudflare R2 / AWS S3 / DigitalOcean Spaces
CLOUD_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
CLOUD_ACCESS_KEY="your_access_key"
CLOUD_SECRET_KEY="your_secret_key"
CLOUD_BUCKET_NAME="r1-bios-dataset"
