# Update Cache & Backup
update_cache/
temp_update_payload/
backup/

# Allow update.zip for auto-update distribution
!update.zip

# Local Secrets & Configuration
config/github_token.json

# Web bundle binaries (keep html/css/js assets)
web/*.exe
web/*.zip
