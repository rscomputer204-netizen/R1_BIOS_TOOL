# Chat logs & Chat saver
chat_*.txt
chat_saver.py
.chat_saver_state.json
chat_history/

# Temporary MEA and verification text dumps in root
mea_*.txt
testing_area_*.txt
test_padding.*

# One-off scratch test scripts in root
test_*.py
fix_*.py
